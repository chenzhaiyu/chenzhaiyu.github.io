{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}
{% assign metadata = site.data.repositories.repo_metadata[include.repository] %}

<div class="repo p-2">
  <a
    class="repo-card"
    href="https://github.com/{{ include.repository }}"
    data-repo="{{ include.repository }}"
    rel="external nofollow noopener"
    target="_blank"
  >
    <div class="repo-card-header">
      <i class="fa-regular fa-bookmark repo-card-icon"></i>
      <span class="repo-card-name">
        {% if show_owner %}{{ include.repository }}{% else %}{{ repo_url[1] }}{% endif %}
      </span>
    </div>
    <p class="repo-card-description">{{ metadata.description | default: 'View this repository on GitHub.' }}</p>
    <div class="repo-card-meta">
      <span class="repo-card-language">
        {% if metadata.language %}
          <span class="repo-card-lang-dot" style="background-color: {{ metadata.language_color | default: '#858585' }}"></span>
          {{ metadata.language }}
        {% endif %}
      </span>
      <span class="repo-card-stars"><i class="fa-regular fa-star"></i> {{ metadata.stars | default: '-' }}</span>
      <span class="repo-card-forks"><i class="fa-solid fa-code-branch"></i> {{ metadata.forks | default: '-' }}</span>
    </div>
  </a>
</div>
