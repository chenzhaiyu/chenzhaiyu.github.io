{% assign metadata = site.data.repositories.github_user_metadata[include.username] %}

<div class="repo p-2">
  <a
    class="repo-card repo-card-user"
    href="https://github.com/{{ include.username }}"
    data-github-user="{{ include.username }}"
    rel="external nofollow noopener"
    target="_blank"
  >
    <div class="repo-card-header">
      <i class="fa-brands fa-github repo-card-icon"></i>
      <span class="repo-card-name">{{ include.username }}</span>
    </div>
    <p class="repo-card-description">@{{ include.username }} on GitHub</p>
    <div class="repo-card-meta">
      <span class="repo-card-repos"><i class="fa-solid fa-book"></i> {{ metadata.public_repos | default: '-' }} repos</span>
      <span class="repo-card-followers"><i class="fa-solid fa-users"></i> {{ metadata.followers | default: '-' }} followers</span>
    </div>
  </a>
</div>
